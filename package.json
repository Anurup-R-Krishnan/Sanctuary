{
  "$schema": "https://json.schemastore.org/package",
  "name": "sanctuary-book-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "Anurup R Krishnan",
  "description": "A modern, cross-platform book reader monorepo",
  "license": "GPL-3.0-only",
  "bugs": "https://github.com/Anurup-R-Krishnan/Sanctuary/issues",
  "homepage": "https://github.com/Anurup-R-Krishnan/Sanctuary#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anurup-R-Krishnan/Sanctuary.git"
  },
  "keywords": [
    "epub",
    "book-reader",
    "ebook",
    "react",
    "monorepo"
  ],
  "files": [
    "apps",
    "packages",
    "functions"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run web:build && echo build success",
    "check": "tsc -p apps/web/tsconfig.json --noEmit && echo check success",
    "desktop:build": "bun run --cwd apps/desktop tauri:build",
    "desktop:dev": "bun run --cwd apps/desktop tauri:dev",
    "dev": "bash -lc 'bun run web:guest & bun run dev:backend:guest; wait -n; kill 0'",
    "dev:backend:guest": "wrangler pages dev apps/web/dist --ip 0.0.0.0 --port 8788 -b DISABLE_CLERK_AUTH=true",
    "dev:backend:guest:remote": "bash -lc 'echo \"wrangler pages dev has no --remote in this Wrangler version; running local Pages dev. Use wrangler --remote commands to verify real D1/R2.\"; wrangler pages dev apps/web/dist --ip 0.0.0.0 --port 8788 -b DISABLE_CLERK_AUTH=true'",
    "dev:backend:strict": "wrangler pages dev apps/web/dist --ip 0.0.0.0 --port 8788 -b DISABLE_CLERK_AUTH=false",
    "dev:remote": "bash -lc 'bun run web:guest & bun run dev:backend:guest:remote; wait -n; kill 0'",
    "dev:strict": "bash -lc 'bun run web:strict & bun run dev:backend:strict; wait -n; kill 0'",
    "lint": "eslint . --cache && echo lint success",
    "lint:commits": "commitlint --from=HEAD~1",
    "lint:fix": "eslint . --fix",
    "mobile:android": "bun run --cwd apps/mobile android",
    "mobile:dev": "bun run --cwd apps/mobile start",
    "mobile:web": "bun run --cwd apps/mobile web",
    "prepare": "husky",
    "test": "bun run --cwd apps/web test",
    "test:desktop": "bun test apps/web/src/services/bookContentRepository.test.ts",
    "postversion": "git push && git push --tags",
    "preview": "bun run web:preview",
    "preversion": "bun run check",
    "web:build": "bun run --cwd apps/web build",
    "web:dev": "bun run --cwd apps/web dev",
    "web:guest": "bun run --cwd apps/web dev:guest",
    "web:preview": "bun run --cwd apps/web preview",
    "web:strict": "bun run --cwd apps/web dev:strict"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/clerk-react": "^5.60.2",
    "foliate-js": "^1.0.1",
    "lucide-react": "^0.555.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rehype-highlight": "^7.0.2",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "uuid": "^13.0.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260131.0",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@eslint/js": "^9.21.0",
    "@types/bun": "^1.3.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^4.9.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.25.0",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.11.3",
    "wrangler": "^4.61.1"
  }
}
