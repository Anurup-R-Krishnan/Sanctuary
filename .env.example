VITE_DISABLE_AUTH=true
VITE_API_PROXY_TARGET=http://127.0.0.1:8788
# Auth mode: set DISABLE_AUTH to "true" ONLY for development/guest mode
# Production must have DISABLE_AUTH=false
DISABLE_AUTH=true
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8788

# API origin for builds not served by Cloudflare Pages (desktop AppImage,
# mobile). Leave unset for the web app (it uses its own origin). A desktop
# build without it runs fully offline: sign-in, sync and catalogs are hidden.
# VITE_API_BASE_URL=https://your-project.pages.dev

# Kokoro read-aloud model. Unset: downloaded from Hugging Face.
# After running tooling/upload-kokoro-model.sh, set to /models/ to serve it from R2.
# VITE_KOKORO_MODEL_BASE=/models/
